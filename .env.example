# Development examples only. Replace credentials before deploying.
APP_NAME=LinkPulse API
APP_ENV=development
LOG_LEVEL=INFO

# Compose hostname. For an API running on the host, use a reachable database address.
DATABASE_URL=postgresql+psycopg://linkpulse:example-password@db:5432/linkpulse

# Used only by the PostgreSQL service in Compose; keep aligned with DATABASE_URL.
POSTGRES_DB=linkpulse
POSTGRES_USER=linkpulse
POSTGRES_PASSWORD=example-password
